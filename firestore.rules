rules_version = '2';

// =========================================================
// Vueltrack — reglas de seguridad de Firestore
// Pegalas en Firebase Console → Firestore Database → Reglas
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() {
      return request.auth != null;
    }

    function datosEquipo(equipoId) {
      return get(/databases/$(database)/documents/equipos/$(equipoId)).data;
    }

    function esMiembro(equipoId) {
      return logueado() && request.auth.uid in datosEquipo(equipoId).miembrosIds;
    }

    function esOrganizador(equipoId) {
      return esMiembro(equipoId)
        && 'organizador' in datosEquipo(equipoId).miembros[request.auth.uid].roles;
    }

    function soloCambian(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---------- Usuarios: cada uno solo su propio documento ----------
    match /usuarios/{uid} {
      allow read, write: if logueado() && request.auth.uid == uid;
    }

    // ---------- Códigos para sumarse a un equipo ----------
    match /codigos/{codigo} {
      allow get: if logueado();
      allow list: if false;
      allow create: if logueado()
        && getAfter(/databases/$(database)/documents/equipos/$(request.resource.data.equipoId)).data.creadoPor == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- Seguimiento para el cliente ----------
    // Cualquiera con el link (token largo al azar) puede ver su entrega; no se pueden listar.
    match /seguimiento/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if logueado() && esMiembro(request.resource.data.equipoId);
      allow delete: if logueado() && esMiembro(resource.data.equipoId);
    }

    // ---------- Equipos ----------
    match /equipos/{equipoId} {

      function yo() {
        return request.auth.uid;
      }

      function soyMiembroAhora() {
        return yo() in resource.data.miembrosIds;
      }

      function soyOrganizadorAhora() {
        return soyMiembroAhora() && 'organizador' in resource.data.miembros[yo()].roles;
      }

      function cambianSoloMisDatos() {
        return request.resource.data.miembros.diff(resource.data.miembros).affectedKeys().hasOnly([yo()]);
      }

      // Sumarse con el código: entra solo como fletero
      function meSumo() {
        return !soyMiembroAhora()
          && resource.data.modo == 'equipo'
          && soloCambian(['miembros', 'miembrosIds'])
          && cambianSoloMisDatos()
          && request.resource.data.miembrosIds.toSet() == resource.data.miembrosIds.toSet().union([yo()].toSet())
          && request.resource.data.miembros[yo()].roles == ['fletero'];
      }

      // Cambiar mis datos: nombre y vehículo (sin tocar los roles)
      function cambioMisDatos() {
        return soyMiembroAhora()
          && soloCambian(['miembros'])
          && cambianSoloMisDatos()
          && request.resource.data.miembros[yo()].diff(resource.data.miembros[yo()]).affectedKeys().hasOnly(['nombre', 'telefono', 'vehiculo', 'gasto']);
      }

      // Salir del equipo
      function meVoy() {
        return soyMiembroAhora()
          && soloCambian(['miembros', 'miembrosIds'])
          && cambianSoloMisDatos()
          && !(yo() in request.resource.data.miembros)
          && request.resource.data.miembrosIds.toSet() == resource.data.miembrosIds.toSet().difference([yo()].toSet());
      }

      allow read: if logueado() && yo() in resource.data.miembrosIds;

      allow create: if logueado()
        && request.resource.data.creadoPor == yo()
        && request.resource.data.miembrosIds == [yo()]
        && request.resource.data.miembros.keys().hasOnly([yo()])
        && 'organizador' in request.resource.data.miembros[yo()].roles;

      allow update: if logueado() && (
        (soyOrganizadorAhora()
          && request.resource.data.codigo == resource.data.codigo
          && request.resource.data.creadoPor == resource.data.creadoPor)
        || meSumo()
        || cambioMisDatos()
        || meVoy()
      );

      allow delete: if false;

      // ---------- Clientes habituales ----------
      match /clientes/{clienteId} {
        allow read: if esMiembro(equipoId);
        allow create, delete: if esOrganizador(equipoId);
        // Los fleteros solo pueden corregir la ubicación ("Estoy en la puerta")
        allow update: if esOrganizador(equipoId)
          || (esMiembro(equipoId) && soloCambian(['lat', 'lng', 'ubicacionVerificada']));
      }

      // ---------- Vueltas del día ----------
      match /vueltas/{fecha} {
        allow read: if esMiembro(equipoId);
        // Solo quien organiza crea, borra, reordena o cambia paradas
        allow create, delete: if esOrganizador(equipoId);
        // El fletero de equipo solo marca cómo le fue (marcas): no puede sumar ni sacar
        // paradas ni tocar el recorrido calculado
        allow update: if esOrganizador(equipoId)
          || (esMiembro(equipoId)
              && soloCambian(['paradas', 'marcas', 'actualizado'])
              && request.resource.data.paradas.size() == resource.data.paradas.size());
      }

      // ---------- Ubicación en vivo: cada fletero publica solo la suya ----------
      match /ubicaciones/{uid} {
        allow read: if esMiembro(equipoId);
        allow write: if esMiembro(equipoId) && request.auth.uid == uid;
      }

      // ---------- Lugares conocidos (marcados en el mapa o con el pin corregido) ----------
      match /lugares/{lugarId} {
        allow read, write: if esMiembro(equipoId);
      }

      // ---------- Comprobantes de entrega (foto y firma) ----------
      match /comprobantes/{comprobanteId} {
        allow read, write: if esMiembro(equipoId);
      }
    }
  }
}
