# Copiá estos nombres en Vercel → Settings → Environment Variables
# (no hace falta crear un archivo .env para publicar)
ORS_API_KEY=tu-clave-de-openrouteservice
FIREBASE_API_KEY=la-apiKey-de-js/firebase-config.js
# Opcional: buscador de Google Places (API nueva). Sin esta variable se usan los buscadores gratuitos.
GOOGLE_MAPS_API_KEY=
